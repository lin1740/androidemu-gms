# GMS 文件载体镜像 / GMS file carrier image
# 使用busybox基础镜像，确保docker create可以正常工作 / Uses busybox base image to ensure docker create works
# 本镜像仅用于存储GMS文件，安装时通过 docker export/docker cp 提取到标准版redroid容器
# This image only stores GMS files, extracted via docker export/docker cp during installation
# 不运行任何服务 / Does not run any services

FROM busybox:latest

LABEL maintainer="androidemu" \
      description="GMS (Google Mobile Services) file carrier for androidemu" \
      usage="docker create --name gms_temp <image> && docker cp gms_temp:/gms/. /tmp/gms/ && docker rm gms_temp" \
      license="GMS is proprietary software of Google LLC. This image is for personal research only."

# 解压GMS文件到 /gms 目录
# Extract GMS files to /gms directory
COPY gms/ /gms/

# 保持容器可创建的占位命令 / Placeholder command to keep container creatable
CMD ["sh"]
